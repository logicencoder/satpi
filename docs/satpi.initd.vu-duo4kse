#!/bin/sh
### BEGIN INIT INFO
# Provides:          satpi
# Required-Start:    $all
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

DAEMON=/usr/bin/satpi_patched
APP_DATA=/etc/satpi
OPTS="--app-data-path $APP_DATA --iface-name eth0"
LOG=/tmp/satpi.log
LOCK=/var/lock/SatPI.lock

running() {
    if [ -f "$LOCK" ]; then
        local pid=$(cat "$LOCK" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

case "$1" in
    start)
        if running; then
            echo "satpi already running"
            exit 0
        fi
        rm -f "$LOCK"
        echo -n "Starting satpi: "
        nohup "$DAEMON" $OPTS >"$LOG" 2>&1 &
        sleep 5
        if running; then
            echo "ok"
        else
            echo "failed"
        fi
        ;;
    stop)
        echo -n "Stopping satpi: "
        if [ -f "$LOCK" ]; then
            kill $(cat "$LOCK" 2>/dev/null) 2>/dev/null
        fi
        killall satpi_patched 2>/dev/null
        rm -f "$LOCK"
        echo "ok"
        ;;
    restart)
        $0 stop
        sleep 2
        $0 start
        ;;
    status)
        if running; then
            echo "satpi running"
        else
            echo "satpi not running"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
exit 0
